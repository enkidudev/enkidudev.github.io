---
import Ascii from "ascii.rest/astro";
---
<aside class="hero-card" aria-label="Operating principle">
  <div class="card-topline">
    <span>FIELD NOTES / 001</span>
    <span>METHOD</span>
  </div>
  <div class="card-kicker">OPERATING PRINCIPLE</div>
  <div class="card-statement">Enumeration<br />before assumptions.</div>
  <div class="method-list">
    <div class="method-item"><span>01 /</span> DISCOVER</div>
    <div class="method-item"><span>02 /</span> ENUMERATE</div>
    <div class="method-item"><span>03 /</span> VALIDATE</div>
    <div class="method-item"><span>04 /</span> DOCUMENT</div>
  </div>
  <div class="card-bottomline">
    <span>THINK BEFORE EXPLOITING</span>
    <span>ENKIDU</span>
  </div>
  <Ascii piece="rain" fps={12} label="Rain falling across open ground" class="hero-rain" />
</aside>
