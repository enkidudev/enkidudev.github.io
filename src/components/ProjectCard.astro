---
const { project } = Astro.props;
---
<article class="project-card">
  <div class="project-meta">
    <span>PROJECT / {project.number}</span>
    <span class="project-status">{project.status}</span>
  </div>
  <div class="project-category">{project.category}</div>
  <h3><a href={project.href}>{project.title}</a></h3>
  <p>{project.description}</p>
  <div class="tag-list">
    {project.stack.map((tag) => <span class="tag">{tag}</span>)}
  </div>
  <div class="project-card-links">
    <a class="text-link" href={project.href}>Explore project <span>↗</span></a>
    {project.repository && (
      <a class="text-link text-link-muted" href={project.repository} target="_blank" rel="noopener noreferrer">
        GitHub <span>↗</span>
      </a>
    )}
  </div>
</article>
