---
import { Icon } from "astro-icon/components";
import type { projects } from "../data/projects";

interface Props {
  project: (typeof projects)[number];
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
---
<article class:list={["project-card", { "project-featured": featured }]}>
  <div class="project-meta"><span>{project.category}</span><span>{project.status}</span></div>
  <h3><a href={project.href}>{project.title}</a></h3>
  <p>{project.description}</p>
  <div class="tag-list">{project.stack.map((tag) => <span class="tag">{tag}</span>)}</div>
  <div class="project-card-links">
    <a class="text-link" href={project.href}>Case study <Icon name="lucide:arrow-up-right" /></a>
    {project.repository && <a class="text-link quiet" href={project.repository}>Source on GitHub <Icon name="lucide:arrow-up-right" /></a>}
  </div>
</article>
