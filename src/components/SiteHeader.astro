---
import { Icon } from "astro-icon/components";

const primary = [
  { label: "Projects", href: "/projects/" },
  { label: "Writeups", href: "/writeups/" },
  { label: "About", href: "/about/" },
  { label: "Credentials", href: "/credentials/" },
  { label: "Contact", href: "/contact/" },
];
const current = Astro.url.pathname;
const credentialPages = ["/certifications/", "/achievements/", "/skills/"];
const active = (href: string) =>
  current === href ? "page" :
  current.startsWith(href) || (href === "/credentials/" && credentialPages.includes(current)) ? "location" : undefined;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href="/" aria-label="Arman Mishra home">arman<span>.</span></a>
    <nav class="nav-links" aria-label="Main navigation">
      {primary.map(({ label, href }) => <a href={href} aria-current={active(href)}>{label}</a>)}
    </nav>
    <a class="button button-secondary header-resume" href="/resume/" aria-current={active("/resume/")}>Résumé <Icon name="lucide:arrow-up-right" /></a>
    <details class="mobile-nav" data-mobile-nav>
      <summary><Icon name="lucide:menu" /> Menu</summary>
      <nav aria-label="Mobile navigation">
        {[...primary, { label: "Résumé", href: "/resume/" }].map(({ label, href }) => (
          <a href={href} aria-current={active(href)}>{label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
