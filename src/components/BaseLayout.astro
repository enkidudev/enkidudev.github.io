---
import "@fontsource/instrument-serif/latin-400.css";
import "@fontsource/instrument-serif/latin-400-italic.css";
import "@fontsource-variable/inter/wght.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { profile, certifications } from "../data/profile";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  work?: { type: "Article" | "CreativeWork"; datePublished?: string };
}

const {
  title = "Arman Mishra | Enkidu",
  description = "Arman Mishra, penetration tester and security researcher.",
  noindex = false,
  work,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL("/social-cover.jpg", Astro.site).href;
const siteUrl = Astro.site!.href;
const person = {
  "@type": "Person",
  "@id": siteUrl + "#arman",
  name: profile.name,
  alternateName: profile.alias,
  jobTitle: profile.title,
  email: profile.email,
  url: siteUrl,
  sameAs: [profile.github, profile.linkedin],
  hasCredential: certifications.map(({ name, issuer }) => ({
    "@type": "EducationalOccupationalCredential", name, recognizedBy: { "@type": "Organization", name: issuer },
  })),
};
const graph = [
  person,
  { "@type": "WebSite", "@id": siteUrl + "#website", name: "Arman Mishra | Enkidu", url: siteUrl, publisher: { "@id": person["@id"] } },
  ...(work ? [{
    "@type": work.type, name: title, headline: title, description, url: canonical,
    datePublished: work.datePublished, author: { "@id": person["@id"] },
  }] : []),
];
const structuredData = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replaceAll("<", "\\u003c");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111613" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={work?.type === "Article" ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="An ink illustration of a wanderer facing a misty forest" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={structuredData} />
    <title>{title}</title>
    <ClientRouter fallback="none" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1"><slot /></main>
    <SiteFooter />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
