---
import BaseLayout from "../../components/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../data/projects";
---
<BaseLayout title="Projects" description="Security tools and lab environments built by Arman Mishra.">
  <section class="page-hero container">
    <div class="eyebrow">PROJECTS / BUILT THROUGH PRACTICE</div>
    <h1>Security tools and lab projects</h1>
    <p class="lead">I build tools to organize assessment evidence and labs to study how Windows domains behave.</p>
  </section>
  <section class="container section" aria-labelledby="project-case-studies">
    <h2 id="project-case-studies" class="section-title">Case studies</h2>
    <div class="project-grid project-grid-light">
      {projects.map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
    </div>
  </section>
</BaseLayout>
