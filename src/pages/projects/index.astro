---
import BaseLayout from "../../components/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../data/projects";
---
<BaseLayout title="Projects | Arman Mishra" description="Security tools and lab environments built by Arman Mishra.">
  <section class="page-hero container">
    <div class="eyebrow">PROJECTS / BUILT THROUGH PRACTICE</div>
    <h1>Tools, systems, and experiments<span class="hero-accent">Made to understand security better.</span></h1>
    <p class="lead">A selection of personal security tooling and environments developed through hands-on work.</p>
  </section>
  <section class="container section" aria-labelledby="project-case-studies">
    <h2 id="project-case-studies" class="section-title">Case studies</h2>
    <div class="project-grid project-grid-light">
      {projects.map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
    </div>
  </section>
</BaseLayout>
