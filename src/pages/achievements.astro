---
import BaseLayout from "../components/BaseLayout.astro";
import { bountySummary, competitions, labs, podiums, wins } from "../data/achievements";

const placements = ["", "1st", "2nd", "3rd", "4th"];
---
<BaseLayout title="Achievements" description="Arman Mishra’s CTF results, private bug bounty outcomes, HackVerse contributions, and lab progress.">
  <header class="page-hero container">
    <h1>Achievements</h1>
    <p class="lead">{wins} CTF wins and {podiums} podium finishes, alongside independent vulnerability research and challenge development.</p>
  </header>
  <section class="container section timeline">
    <article class="timeline-item">
      <h2>CTF results</h2>
      <div class="table-scroll" role="region" aria-label="CTF results table" tabindex="0">
        <table class="results-table">
          <caption>Competition results, 2025–2026</caption>
          <thead><tr><th scope="col">Event</th><th scope="col">Place</th><th scope="col">Format</th><th scope="col">Details</th></tr></thead>
          <tbody>{competitions.map(({ event, place, format, detail }) => (
            <tr><th scope="row">{event}</th><td>{placements[place]}</td><td>{format ?? "—"}</td><td>{detail ?? "—"}</td></tr>
          ))}</tbody>
        </table>
      </div>
    </article>
    <article class="timeline-item">
      <h2>Vulnerability research</h2>
      <p>{bountySummary}</p>
      <p>I’ve submitted five or more vulnerability reports, including responsible disclosures to organizations without formal programs.</p>
    </article>
    <article class="timeline-item">
      <h2>HackVerse CTF</h2>
      <p>As a ScriptJackers member, I designed and shipped seven challenges for HackVerse in October 2026 with the Ginius Cyber Security Council. The set included four forensics challenges and three boxes, with containerized infrastructure and verified solve paths.</p>
      <a class="text-link" href="/documents/GCS_HackVerse_Appreciation_Letter.pdf">View the appreciation letter ↗</a>
    </article>
    <article class="timeline-item">
      <h2>Hack The Box labs</h2>
      <ul>{labs.map(({ name, progress }) => <li><strong>{name}</strong> · {progress}</li>)}</ul>
    </article>
  </section>
</BaseLayout>
