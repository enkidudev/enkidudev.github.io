---
import { Icon } from "astro-icon/components";
import BaseLayout from "../../components/BaseLayout.astro";
import { writeups, writeupCount } from "../../data/writeups";

const categories = [...new Set(writeups.map((post) => post.category))].sort();
const tags = [...new Set(writeups.flatMap((post) => post.tags))].sort();
const dates = new Intl.DateTimeFormat("en-IN", { dateStyle: "medium", timeZone: "UTC" });
---
<BaseLayout title="Writeups & Research" description="Technical writeups and security research by Arman Mishra.">
  <header class="page-hero container">
    <p class="eyebrow">Research</p>
    <h1>Field notes.</h1>
    <p class="lead">Technical writeups on penetration testing, Active Directory, web security, and independent research.</p>
    <a class="text-link" href="/rss.xml">Subscribe via RSS</a>
  </header>
  <section class="container section" aria-label="Published writeups">
    {writeupCount > 0 ? (
      <>
        <div class="writeup-filters">
          <label>Search <input type="search" placeholder="Title, topic, or tag" data-writeup-search /></label>
          <label>Category <select data-writeup-category><option value="">All categories</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></label>
          <label>Technology <select data-writeup-tag><option value="">All tags</option>{tags.map((tag) => <option value={tag}>{tag}</option>)}</select></label>
        </div>
        <p class="small-note" role="status" data-results-count>{writeupCount} {writeupCount === 1 ? "writeup" : "writeups"}</p>
        <div class="writeup-grid">
          {writeups.map((post) => (
            <article class="writeup-card" data-writeup-card data-category={post.category} data-tags={JSON.stringify(post.tags)}
              data-search={`${post.title} ${post.description} ${post.category} ${post.difficulty} ${post.tags.join(" ")}`.toLowerCase()}>
              <div class="project-meta"><span>{post.category}</span><time datetime={post.date}>{dates.format(new Date(post.date))}</time></div>
              <h2><a href={`/writeups/${post.slug}/`}>{post.title}</a></h2>
              <p>{post.description}</p>
              <div class="tag-list">
                <span class="tag">{post.readingMinutes} min read</span>
                {post.difficulty && <span class="tag">{post.difficulty}</span>}
                {post.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
              <a class="text-link" href={`/writeups/${post.slug}/`}>Read writeup <Icon name="lucide:arrow-up-right" /></a>
            </article>
          ))}
        </div>
        <p data-no-results hidden>No writeups match those filters.</p>
      </>
    ) : (
      <div class="empty-state"><h2>No published writeups yet.</h2><p>In the meantime, browse the <a href="/projects/">project case studies</a>.</p></div>
    )}
  </section>
</BaseLayout>
