---
import BaseLayout from "../components/BaseLayout.astro";
---
<BaseLayout noindex title="Page not found">
  <section class="page-hero container">
    <div class="eyebrow">404 / NOT FOUND</div>
    <h1>Page not found</h1>
    <p class="lead">The requested page may have moved or may not exist.</p>
    <a class="button button-primary" href="/">Return home <span>↗</span></a>
  </section>
</BaseLayout>
