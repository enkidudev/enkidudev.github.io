---
import BaseLayout from "../components/BaseLayout.astro";
import { certifications } from "../data/profile";
import { podiums, wins } from "../data/achievements";
---
<BaseLayout title="Credentials" description="Certifications, competition results, and technical skills for Arman Mishra.">
  <header class="page-hero container">
    <h1>Credentials</h1>
    <p class="lead">Professional certifications, competition results, and practical skills.</p>
  </header>
  <section class="container section">
    <ul class="editorial-list">
      <li><a href="/certifications/"><span>Certifications<small>{certifications.map(({ short }) => short).join(" · ")}</small></span><span aria-hidden="true">↗</span></a></li>
      <li><a href="/achievements/"><span>Achievements<small>{wins} CTF wins · {podiums} podium finishes · HackVerse · lab progress</small></span><span aria-hidden="true">↗</span></a></li>
      <li><a href="/skills/"><span>Technical skills<small>Web, networks, Active Directory, and development</small></span><span aria-hidden="true">↗</span></a></li>
    </ul>
  </section>
</BaseLayout>
