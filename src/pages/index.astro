---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "../components/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import FieldNote from "../components/FieldNote.astro";
import heroArt from "../assets/forest-wanderer.webp";
import { profile, certifications } from "../data/profile";
import { projects } from "../data/projects";
import { writeups } from "../data/writeups";

const expertise = [
  { title: "Web & API", detail: "Application behaviour, authentication, and trust boundaries." },
  { title: "Network", detail: "Service discovery, fingerprinting, and evidence-led triage." },
  { title: "Active Directory", detail: "Windows environments, identity, and authentication." },
];
---
<BaseLayout title="Arman Mishra | Enkidu, Penetration Tester" description="Arman Mishra, known as Enkidu. Penetration testing, security research, independent projects, and technical writeups.">
  <section class="container hero">
    <div class="hero-copy">
      <p class="eyebrow">Arman Mishra <span aria-hidden="true">/</span> Penetration Tester</p>
      <h1>Hey, I’m <em>Enkidu.</em></h1>
      <p class="hero-tagline">{profile.tagline}</p>
      <p class="hero-description">I research how web applications, networks, and Active Directory environments fail, and build tools to make that work easier to verify.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/projects/">Explore projects <Icon name="lucide:arrow-up-right" /></a>
        <a class="button button-secondary" href="/writeups/">Read writeups</a>
        <a class="text-link" href="/resume/">Résumé <Icon name="lucide:arrow-up-right" /></a>
      </div>
      <div class="hero-socials">
        <a href={profile.github}><Icon name="lucide:github" /> GitHub</a>
        <a href={profile.linkedin}><Icon name="lucide:linkedin" /> LinkedIn</a>
        <a href={`mailto:${profile.email}`}><Icon name="lucide:mail" /> Email</a>
      </div>
    </div>
    <figure class="hero-art">
      <Image src={heroArt} alt="An ink-drawn wanderer faces a stone passage in a misty evergreen forest" widths={[400, 650, 900, 1100]} sizes="(max-width: 760px) 92vw, (max-width: 1250px) 47vw, 570px" quality={72} loading="eager" fetchpriority="high" />
    </figure>
  </section>

  <div class="credential-strip">
    <div class="container">
      <span class="eyebrow">Certifications</span>
      {certifications.map(({ short, issuer }) => (
        <a href="/certifications/"><strong>{short}</strong><span>{issuer}</span><Icon name="lucide:arrow-up-right" /></a>
      ))}
    </div>
  </div>

  <section class="container section">
    <SectionHeading eyebrow="Expertise" title="Where I work" />
    <div class="expertise-grid">
      {expertise.map(({ title, detail }) => <article><h3>{title}</h3><p>{detail}</p></article>)}
    </div>
    <a class="text-link section-end-link" href="/skills/">Technical toolkit <Icon name="lucide:arrow-up-right" /></a>
  </section>

  <section class="section section-soft">
    <div class="container split-section">
      <div>
        <div class="eyebrow">Methodology</div>
        <h2>Enumeration first.</h2>
        <p>Every finding starts as a hypothesis. I trace it back to the evidence, validate the impact, and document what the results support.</p>
      </div>
      <FieldNote />
    </div>
  </section>

  <section class="container section">
    <SectionHeading eyebrow="Selected projects" title="Tools and lab work" />
    <div class="project-grid">
      {projects.map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <SectionHeading eyebrow="Research" title="Field notes" />
      {writeups.length > 0 ? (
        <ul class="editorial-list">
          {writeups.slice(0, 3).map((post) => (
            <li><a href={`/writeups/${post.slug}/`}><span><small>{post.category} · {post.readingMinutes} min read</small>{post.title}</span><Icon name="lucide:arrow-up-right" /></a></li>
          ))}
        </ul>
      ) : <p class="lead">Published articles will appear here when available.</p>}
      <a class="text-link section-end-link" href="/writeups/">Browse writeups <Icon name="lucide:arrow-up-right" /></a>
    </div>
  </section>

  <section class="container section split-section">
    <div>
      <div class="eyebrow">Achievements</div>
      <h2>Beyond the lab</h2>
      <p>CTF competition wins, independent vulnerability disclosures, and challenge development for HackVerse.</p>
      <a class="text-link" href="/achievements/">Achievements and recognition <Icon name="lucide:arrow-up-right" /></a>
    </div>
    <div>
      <div class="eyebrow">About</div>
      <h2>Arman Mishra</h2>
      <p>I’m studying cybersecurity, building my own lab environments, and working toward a career in security research.</p>
      <a class="text-link" href="/about/">More about me <Icon name="lucide:arrow-up-right" /></a>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container contact-banner">
      <div><div class="eyebrow">Contact</div><h2>Let’s talk security.</h2></div>
      <a class="button button-primary" href="/contact/">Get in touch <Icon name="lucide:arrow-up-right" /></a>
    </div>
  </section>
</BaseLayout>
