---
import BaseLayout from "../components/BaseLayout.astro";
import AsciiHeroCard from "../components/AsciiHeroCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import MetricCard from "../components/MetricCard.astro";
import { profile, metrics, certifications } from "../data/profile";
import { projects } from "../data/projects";
---
<BaseLayout title="Arman Mishra | Enkidu — Penetration Tester" description="The portfolio of Arman Mishra, known as Enkidu. Penetration testing, independent security research, CTF development, and security tooling.">
  <section class="container hero" id="top">
    <div class="hero-copy">
      <div class="eyebrow">PENETRATION TESTER / SECURITY RESEARCHER</div>
      <h1>Arman Mishra<span class="hero-accent">The wild man learnt to enumerate.</span></h1>
      <p class="hero-description">
        I’m Arman, known as Enkidu. I work across web, network, Windows, Linux, and Active Directory security.
        My approach is grounded in careful enumeration, evidence-led validation, and practical security research.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/projects/">Explore my work <span>↘</span></a>
        <a class="button button-secondary" href="/contact/">Contact me <span>↗</span></a>
      </div>
      <div class="hero-socials">
        <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a href={`mailto:${profile.email}`}>Email ↗</a>
      </div>
    </div>
    <AsciiHeroCard />
  </section>

  <section class="metrics-band">
    <div class="container metrics-grid">
      {metrics.map((metric) => <MetricCard {...metric} />)}
    </div>
  </section>

  <section class="container section">
    <SectionHeading
      eyebrow="01 / THE APPROACH"
      title="Curiosity, followed by evidence."
      description="Good security testing starts with understanding the environment. Enumeration comes first; assumptions do not count as findings."
    />
    <div class="principle-grid">
      <article class="principle-card"><span>01</span><h3>Discover</h3><p>Map the attack surface and identify what is actually exposed.</p></article>
      <article class="principle-card"><span>02</span><h3>Enumerate</h3><p>Collect context, relationships, configurations, and useful evidence.</p></article>
      <article class="principle-card"><span>03</span><h3>Validate</h3><p>Test hypotheses and distinguish a possible weakness from a demonstrated issue.</p></article>
      <article class="principle-card"><span>04</span><h3>Document</h3><p>Explain the evidence, impact, reproduction, and practical remediation.</p></article>
    </div>
  </section>

  <section class="section section-dark" id="work">
    <div class="container">
      <SectionHeading
        eyebrow="02 / SELECTED WORK"
        title="Built, tested, documented."
        description="Security tooling and environments developed through practical work and independent experimentation."
      />
      <div class="project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
      <div class="section-end-link"><a class="text-link text-link-light" href="/projects/">View all projects <span>↗</span></a></div>
    </div>
  </section>

  <section class="container section">
    <SectionHeading
      eyebrow="03 / CREDENTIALS"
      title="Validated learning."
      description="Professional certifications backed by practical security training and hands-on assessment work."
    />
    <div class="credential-preview-grid">
      {certifications.map((cert) => (
        <article class="credential-card">
          <div class="credential-mark">{cert.short}</div>
          <div class="credential-issuer">{cert.issuer}</div>
          <h3>{cert.name}</h3>
          <a class="text-link" href={cert.url} target="_blank" rel="noopener noreferrer">Verify credential <span>↗</span></a>
        </article>
      ))}
    </div>
    <div class="section-end-link"><a class="text-link" href="/certifications/">Certification details <span>↗</span></a></div>
  </section>

  <section class="section section-soft">
    <div class="container split-section">
      <div>
        <div class="eyebrow">04 / FIELD EXPERIENCE</div>
        <h2>Beyond the laboratory.</h2>
      </div>
      <div class="split-copy">
        <p>Independent vulnerability disclosures, paid bounty findings, CTF challenge development, and a custom Active Directory attack lab.</p>
        <p>Contributed forensic challenges and boot-to-root machines to the HackVerse CTF platform through Script Jackers, with recognition from Ginius Cyber Security Council.</p>
        <a class="button button-primary" href="/achievements/">Explore achievements <span>↗</span></a>
      </div>
    </div>
  </section>

  <section class="container section contact-banner">
    <div>
      <div class="eyebrow">05 / GET IN TOUCH</div>
      <h2>Have something worth investigating?</h2>
      <p>For security opportunities, research, CTF development, or collaboration.</p>
    </div>
    <a class="button button-primary" href="/contact/">Contact Arman <span>↗</span></a>
  </section>
</BaseLayout>
