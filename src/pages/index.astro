---
import { Icon } from "astro-icon/components";
import BaseLayout from "../components/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import FieldNote from "../components/FieldNote.astro";
import { profile } from "../data/profile";
import { wins, podiums } from "../data/achievements";
import { projects } from "../data/projects";
import { writeups } from "../data/writeups";

const expertise = [
  { title: "Web & API", detail: "I test how applications handle data, authenticate users, and enforce access." },
  { title: "Network", detail: "I map exposed services and verify what each one reveals about the network." },
  { title: "Active Directory", detail: "I study how identity, permissions, and authentication shape security in Windows domains." },
];
---
<BaseLayout description="Arman Mishra is a CPTS- and PJPT-certified penetration tester and cybersecurity researcher focused on web apps, APIs, internal networks, and Active Directory.">
  <div class="home-hero">
    <section class="container hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow">Penetration tester &amp; security researcher</p>
        <h1 id="home-title">Arman <em>Mishra.</em></h1>
        <p class="hero-tagline">{profile.tagline}</p>
        <p class="hero-description">I test web apps, APIs, internal networks, and Active Directory. I build tools to make assessments easier to document and reproduce.</p>
        <p class="hero-proof"><a href="/certifications/">CPTS · PJPT</a> <span aria-hidden="true">·</span> <a href="/achievements/">{wins} CTF wins · {podiums} podiums · HTB Dante completed</a></p>
        <div class="hero-actions">
          <a class="button button-primary" href="/about/" data-astro-prefetch>About me <Icon name="lucide:arrow-up-right" /></a>
          <a class="button button-secondary" href="/projects/" data-astro-prefetch>Explore projects</a>
          <a class="text-link" href="/resume/">Résumé <Icon name="lucide:arrow-up-right" /></a>
        </div>
        <div class="hero-socials">
          <a href={profile.github} rel="me"><Icon name="lucide:github" /> GitHub</a>
          <a href={profile.linkedin} rel="me"><Icon name="lucide:linkedin" /> LinkedIn</a>
          <a href={`mailto:${profile.email}`}><Icon name="lucide:mail" /> Email</a>
        </div>
      </div>
      <figure class="hero-art">
        <div class="hero-art-stage">
          <div class="ascii-stage" data-ascii-stage hidden></div>
          <p class="ascii-status" role="status" data-ascii-status>Rainforest Falls Mist</p>
        </div>
        <figcaption>
          <span>Rainforest Falls Mist</span>
          <button class="art-toggle" type="button" hidden data-ascii-toggle>Pause ASCII</button>
        </figcaption>
      </figure>
    </section>
  </div>

  <section class="container section">
    <h2 class="section-title">What I test</h2>
    <div class="expertise-grid">
      {expertise.map(({ title, detail }) => <article><h3>{title}</h3><p>{detail}</p></article>)}
    </div>
    <a class="text-link section-end-link" href="/skills/">Technical toolkit <Icon name="lucide:arrow-up-right" /></a>
  </section>

  <section class="section section-soft">
    <div class="container split-section">
      <div>
        <h2>Enumeration first.</h2>
        <p>I start by mapping what’s exposed, then verify what I can reach and why it matters. I document the evidence so another tester can reproduce the finding.</p>
      </div>
      <FieldNote />
    </div>
  </section>

  <section class="container section">
    <h2 class="section-title">Tools and lab work</h2>
    <div class="project-grid">
      {projects.map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <h2 class="section-title">Security writeups</h2>
      {writeups.length > 0 ? (
        <ul class="editorial-list">
          {writeups.slice(0, 3).map((post) => (
            <li><a href={`/writeups/${post.slug}/`}><span><small>{post.category} · {post.readingMinutes} min read</small>{post.title}</span><Icon name="lucide:arrow-up-right" /></a></li>
          ))}
        </ul>
      ) : <p class="lead">Read about my tools and Windows lab in the <a class="inline-link" href="/projects/">project case studies</a>.</p>}
      {writeups.length > 0 && <a class="text-link section-end-link" href="/writeups/">Browse all writeups <Icon name="lucide:arrow-up-right" /></a>}
    </div>
  </section>

  <section class="container section split-section">
    <div>
      <h2>Beyond the lab</h2>
      <p>CTF competition wins, independent vulnerability disclosures, and challenge development for HackVerse.</p>
      <a class="text-link" href="/achievements/">Achievements and recognition <Icon name="lucide:arrow-up-right" /></a>
    </div>
    <div>
      <h2>A little about me</h2>
      <p>I study cybersecurity at Lovely Professional University. Away from the keyboard, I’m usually reading poetry, listening to music, or looking for a trail.</p>
      <a class="text-link" href="/about/">Read my bio <Icon name="lucide:arrow-up-right" /></a>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container contact-banner">
      <div><h2>Internships and collaborations</h2><p>{profile.availability}.</p></div>
      <a class="button button-primary" href={`mailto:${profile.email}`}>Email me <Icon name="lucide:arrow-up-right" /></a>
    </div>
  </section>
</BaseLayout>
