---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import { blogDate, blogPosts } from "../../data/blog";
import { profile } from "../../data/profile";

export const getStaticPaths = (async () => {
  const posts = await blogPosts();
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { category, date, description, title } = post.data;
const { Content, headings } = await render(post);
const sections = headings.filter(({ depth }) => depth === 2 || depth === 3);
const publishedAt = date.toISOString();
---
<BaseLayout title={title} description={description} work={{ type: "Article", datePublished: publishedAt }}>
  <progress class="reading-progress" data-reading-progress max="1" value="0" aria-label="Article reading progress"></progress>
  <header class="container article-header">
    <a class="text-link" href="/blog/">← Blog</a>
    <p class="eyebrow">{category}</p>
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <div class="article-meta">
      <span>{profile.name}</span>
      <time datetime={publishedAt}>{blogDate.format(date)}</time>
    </div>
  </header>
  <div class="container article-layout">
    {sections.length > 0 && (
      <nav class="article-sidebar" aria-label="Table of contents">
        <strong>On this page</strong>
        <ul>{sections.map(({ depth, slug, text }) => (
          <li class:list={[{ indent: depth === 3 }]}><a href={`#${slug}`}>{text}</a></li>
        ))}</ul>
      </nav>
    )}
    <article class="article-prose"><Content /></article>
  </div>
</BaseLayout>
